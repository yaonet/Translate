<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Translate.Views.GeminiSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Translate.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24">
            <TextBlock Text="Gemini 设置" Style="{StaticResource TitleTextBlockStyle}"/>
            
            <StackPanel Spacing="4">
                <TextBlock Text="API Key" Style="{StaticResource CaptionTextBlockStyle}"/>
                <PasswordBox x:Name="GeminiApiKeyBox"
                             PlaceholderText="Enter your Gemini API key"
                             PasswordChanged="GeminiApiKeyBox_PasswordChanged"/>
            </StackPanel>
            
            <StackPanel Spacing="4">
                <TextBlock Text="Model" Style="{StaticResource CaptionTextBlockStyle}"/>
                <TextBox x:Name="GeminiModelTextBox"
                         PlaceholderText="e.g., gemini-flash-latest"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
