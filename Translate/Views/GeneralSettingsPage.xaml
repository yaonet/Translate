<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Translate.Views.GeneralSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Translate.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="常规设置" Style="{StaticResource TitleTextBlockStyle}"/>
            
            <!-- Max History Count Setting -->
            <StackPanel Spacing="8">
                <TextBlock Text="历史记录上限" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <NumberBox x:Name="MaxHistoryNumberBox"
                               Value="{x:Bind MaxHistoryCount, Mode=TwoWay}"
                               Minimum="10"
                               Maximum="10000"
                               SpinButtonPlacementMode="Compact"
                               SmallChange="10"
                               LargeChange="100"
                               Width="150"
                               ValueChanged="MaxHistoryNumberBox_ValueChanged"/>
                    <TextBlock Text="条" 
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <TextBlock Text="设置翻译历史的最大保存条数（10-10000）"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
