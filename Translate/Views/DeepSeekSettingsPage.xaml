<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Translate.Views.DeepSeekSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Translate.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24">
            <TextBlock Text="DeepSeek 设置" Style="{StaticResource TitleTextBlockStyle}"/>
            
            <StackPanel Spacing="4">
                <TextBlock Text="API Key" Style="{StaticResource CaptionTextBlockStyle}"/>
                <PasswordBox x:Name="DeepSeekApiKeyBox"
                             PlaceholderText="Enter your DeepSeek API key"
                             Password="{x:Bind ViewModel.DeepSeekApiKey, Mode=TwoWay}"
                             PasswordChanged="DeepSeekApiKeyBox_PasswordChanged"/>
            </StackPanel>
            
            <StackPanel Spacing="4">
                <TextBlock Text="Base URL" Style="{StaticResource CaptionTextBlockStyle}"/>
                <TextBox Text="{x:Bind ViewModel.DeepSeekBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="e.g., https://api.deepseek.com"/>
            </StackPanel>
            
            <StackPanel Spacing="4">
                <TextBlock Text="Model" Style="{StaticResource CaptionTextBlockStyle}"/>
                <TextBox Text="{x:Bind ViewModel.DeepSeekModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="e.g., deepseek-chat"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
