<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Translate.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Translate"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Translate">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar"
                  Title="">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xF2B7;"/>
            </TitleBar.IconSource>
            <TitleBar.Content>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleButton x:Name="AutoTranslateToggle"
                                  Margin="0,0,5,0"
                                  ToolTipService.ToolTip="划词翻译"
                                  IsChecked="{x:Bind IsAutoTranslateEnabled, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderBrush="Transparent">
                        <FontIcon Glyph="&#xE962;" FontSize="14"/>
                    </ToggleButton>
                    <ToggleButton x:Name="AlwaysOnTopToggle"
                                   Margin="0,0,5,0"
                                  ToolTipService.ToolTip="置顶"
                                  IsChecked="{x:Bind IsAlwaysOnTop, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderBrush="Transparent">
                        <FontIcon Glyph="&#xE718;" FontSize="14"/>
                    </ToggleButton>
                    <Button x:Name="ThemeToggle"
                                  Margin="0,0,5,0"
                                  ToolTipService.ToolTip="切换主题"
                                  Background="Transparent"
                                  BorderBrush="Transparent"
                                  Click="ToggleTheme">
                        <FontIcon Glyph="{x:Bind ThemeIcon, Mode=OneWay}" FontSize="14"/>
                    </Button>
                    <Button x:Name="SettingToggle"
                                  ToolTipService.ToolTip="设置"
                                  Background="Transparent"
                                  BorderBrush="Transparent">
                        <FontIcon Glyph="&#xE713;" FontSize="14"/>
                    </Button>
                </StackPanel>
            </TitleBar.Content>
        </TitleBar>
        <TextBox Grid.Row="1"
                 Margin="5,0,5,5"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontSize="16"
                 Text="{x:Bind SourceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <ComboBox Margin="5,0"
                      HorizontalAlignment="Center"
                      ItemsSource="{x:Bind Code}"
                      SelectedItem="{x:Bind SourceCode, Mode=TwoWay}">
            </ComboBox>
            <Button ToolTipService.ToolTip="Switch language"
                     Click="SwitchLanguage">
                <FontIcon Glyph="&#xE8AB;" FontSize="14"/>
            </Button>
            <ComboBox 
                      Margin="5,0"
                      HorizontalAlignment="Center"
                      ItemsSource="{x:Bind Code}"
                      SelectedItem="{x:Bind TargetCode, Mode=TwoWay}">
            </ComboBox>
            <Button ToolTipService.ToolTip="Switch Text"
                    Click="SwitchText">
                <FontIcon Glyph="&#xE8AB;" FontSize="14" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <RotateTransform Angle="90"/>
                    </FontIcon.RenderTransform>
                </FontIcon>
            </Button>
            <Button Content="Translate"
                    Click="DoTranslate"
                    Margin="5,0" />
        </StackPanel>
        <TextBox Grid.Row="3"
                 Margin="5"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontSize="16"
                 IsReadOnly="True"
                 Text="{x:Bind TargetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

    </Grid>
</Window>
